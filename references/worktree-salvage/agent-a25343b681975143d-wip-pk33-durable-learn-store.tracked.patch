+
+/**
+ * Build the app with the learner-state mode the ENVIRONMENT dictates, and SAY WHICH at boot.
+ *
+ *   ZSM_MASTER_KEK unset/empty ⇒ ephemeral (in-memory) + the loud EPHEMERAL_BOOT_LINE.
+ *   ZSM_MASTER_KEK set         ⇒ durable PGlite at ZSM_DATA_DIR (server default `.zsm-data/`).
+ *   ZSM_MASTER_KEK malformed   ⇒ THROWS. A typo'd key is a config error, never a silent downgrade.
+ *
+ * `log` is injectable so the boot line can be asserted by tests instead of eyeballed.
+ */
+export const createAppFromEnv = async (
+  env: EnvLike = process.env,
+  fallbackDataDir: string = DEFAULT_DATA_DIR,
+  log: (line: string) => void = console.warn,
+): Promise<AppInstance> => {
+  const persistence = resolveLearnPersistence(env, fallbackDataDir);
+
+  if (persistence.mode === "ephemeral") {
+    // LOUD by design: an operator who expected durability must not discover the truth from lost learner work.
+    log(EPHEMERAL_BOOT_LINE);
+    return { app: createApp(), mode: "ephemeral", dataDir: null, close: () => Promise.resolve(), durable: null };
+  }
+
+  const handle = await createDurableLearnStore({
+    kek: persistence.kek,
+    dataDir: persistence.dataDir,
+    confusability: getDemoConfusability(),
+  });
+  log(durableBootLine(persistence.dataDir));
+  return {
+    app: createApp({ learnStore: handle.store }),
+    mode: "durable",
+    dataDir: persistence.dataDir,
+    close: handle.close,
+    durable: handle,
+  };
+};
