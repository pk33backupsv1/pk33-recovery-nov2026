+// ── Env-driven assembly: the ONE place that decides durable vs ephemeral learner state ──────────────────────
+
+export interface AppInstance {
+  readonly app: Hono;
+  /** Which learner-state mode this instance booted in — computed from the env, never assumed. */
+  readonly mode: "durable" | "ephemeral";
+  /** The PGlite data dir in durable mode (`:memory:` when in-memory); null in ephemeral mode. */
+  readonly dataDir: string | null;
+  /** Release durable resources (a no-op in ephemeral mode). Safe to call more than once is NOT assumed. */
+  readonly close: () => Promise<void>;
+  /**
+   * Admin-only durable operations; null in ephemeral mode. Crypto-shred lives here and NOWHERE on the HTTP
+   * surface — mirroring @zsm/store's ServingEventStore/EventStore split (security review M3).
+   */
+  readonly durable: DurableLearnStoreHandle | null;
